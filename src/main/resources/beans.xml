<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean id = "principal" class = "org.example.crud.Principal">
        <property name="name" value="Ravi Ankam"/>
        <property name="mobile" value="9475867369"/>
    </bean>

    <bean id = "getColleges" class = "org.example.crud.GetColleges">
        <property name="id" value="101"/>
        <property name="principal" ref="principal"/>
    </bean>

</beans>